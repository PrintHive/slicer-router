{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slicer Router",
  "identifier": "com.printhive.slicer-router",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "category": "DeveloperTool",
    "shortDescription": "Opens .3mf files in the slicer that made them",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["3mf"],
        "name": "3MF Project",
        "description": "3MF Project",
        "mimeType": "model/3mf",
        "role": "Editor"
      }
    ]
  }
}
